# ---------------------------------------------------------------- required

# Postgres connection string. Any Postgres works — Neon, Supabase, RDS, local.
# Managed providers usually need ?sslmode=require on the end.
DATABASE_URL=postgresql://user:password@localhost:5432/dr71codes

# Signs the session cookie. At least 32 characters.
#   openssl rand -base64 32
AUTH_SECRET=

# OpenRouter API key for the six-agent pipeline. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Stripe. Use test keys (sk_test_...) until you are ready to charge.
STRIPE_SECRET_KEY=
# The recurring £17.99/month price you created in Stripe (starts with price_).
STRIPE_PRICE_ID=
# From `stripe listen` locally, or the webhook endpoint's signing secret in
# the Stripe dashboard for a deployed app.
STRIPE_WEBHOOK_SECRET=

# Absolute URL of this deployment. Used for Stripe redirect targets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- optional

# Model selection. Any OpenRouter model id works.
# Simplest: set one model for everything.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Or set a cheaper model for the two spec-writing stages and a stronger one
# for the four code stages.
# OPENROUTER_MODEL_PLANNING=anthropic/claude-haiku-4.5
# OPENROUTER_MODEL_CODING=anthropic/claude-sonnet-4.5
# Or override any single stage. These win over the two settings above.
# OPENROUTER_MODEL_ARCHITECT=
# OPENROUTER_MODEL_RISK=
# OPENROUTER_MODEL_CODER=
# OPENROUTER_MODEL_DEBUGGER=
# OPENROUTER_MODEL_VERIFIER=
# OPENROUTER_MODEL_FINALIZER=

# Shown on your OpenRouter usage dashboard.
# OPENROUTER_SITE_URL=https://your-domain.com
# OPENROUTER_APP_NAME=DR71Codes

# Fair-use cap per subscriber, per hour. Keeps model spend predictable.
# GENERATION_LIMIT_PER_HOUR=30

# Force TLS on or off for the database connection. Defaults to on in
# production, off in development.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Point the pipeline at a different OpenAI-compatible endpoint (a gateway, a
# proxy, or a local stub). Must NOT include the /chat/completions suffix.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
